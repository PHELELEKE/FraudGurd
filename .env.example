# Copy this file to .env.local and fill in your own values.

# Neon dashboard > Connect > copy the connection string
DATABASE_URL="postgresql://user:password@ep-something.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Used to sign login cookies. Optional locally, REQUIRED when deployed. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Shows the one-click demo accounts on the login page. Set to false to hide them.
DEMO_MODE="true"

# Optional semantic duplicate suggestions for pending purchase requests.
# Set both values to enable; Groq receives only item text, category and quantity.
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"
GROQ_DUPLICATE_CHECK="false"

# ---- Accounts and passwords (all optional) ----

# If set, people must enter this code to register. Share it only with staff.
SIGNUP_CODE=""

# Forgot-password emails. Leave both keys empty to skip email: in demo mode the reset link is shown on screen instead.
# Use ONE of these. MAIL_FROM must be an address the service has verified for you.
BREVO_API_KEY=""
RESEND_API_KEY=""
MAIL_FROM="FraudGuard <you@example.com>"

# The public address of the site, used in reset emails. Usually not needed.
APP_URL=""
